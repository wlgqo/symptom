<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.symptom.mapper.ReportCardMapper">

    <resultMap id="BaseResultMap" type="ReportCard">
        <id column="id" property="id"/>
        <result column="case_id" property="caseId"/>
        <result column="card_no" property="cardNo"/>
        <result column="report_type" property="reportType"/>
        <result column="report_date" property="reportDate" typeHandler="com.symptom.config.SqliteDateTypeHandler"/>
        <result column="reporter" property="reporter"/>
        <result column="status" property="status"/>
    </resultMap>

    <select id="findByCaseId" resultMap="BaseResultMap">
        SELECT * FROM report_card WHERE case_id = #{caseId}
    </select>
</mapper>

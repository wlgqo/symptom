<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.symptom.mapper.CaseModifyLogMapper">

    <resultMap id="BaseResultMap" type="CaseModifyLog">
        <id column="id" property="id"/>
        <result column="case_id" property="caseId"/>
        <result column="operator" property="operator"/>
        <result column="modify_time" property="modifyTime" typeHandler="com.symptom.config.SqliteDateTypeHandler"/>
        <result column="snapshot" property="snapshot"/>
        <result column="change_desc" property="changeDesc"/>
    </resultMap>

    <select id="findByCaseId" resultMap="BaseResultMap">
        SELECT * FROM case_modify_log WHERE case_id = #{caseId} ORDER BY modify_time DESC
    </select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO case_modify_log (case_id, operator, snapshot, change_desc)
        VALUES (#{caseId}, #{operator}, #{snapshot}, #{changeDesc})
    </insert>
</mapper>
